# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.python-version

# Virtual environments
.venv

# Configuration files with sensitive data
config.yaml
config_compose.yaml
# Resolved at startup from the .template files. Contains the local host/IP, so
# it must never be committed. The templates are the source of truth.
.generated/
# Same idea, for the files that used to be resolved in place. start.sh only
# reads the *.template versions; these leftovers carry a hardcoded localhost.
config_compose.yaml
realm/lab-realm.json
# Which host the running stack was built with. Local state, not project config.
.authlab-host.last
# Same idea, for the compose variable substitution. docker compose reads this
# file automatically, and start.sh exports the variable itself, so this only
# matters when someone runs `docker compose up` by hand -- which is exactly the
# case that used to recreate Keycloak with ${AUTHLAB_HOST:-localhost} and break
# every login without saying a word.
.env
# Local Pi runtime state
.atl/
# Agent task logs (odd/tasks/...). Local run state, not project content.
odd/
